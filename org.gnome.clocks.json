{
    "id": "org.gnome.clocks",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51beta",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.vala"
    ],
    "build-options": {
        "prepend-path": "/usr/lib/sdk/vala/bin/",
        "prepend-ld-library-path": "/usr/lib/sdk/vala/lib"
    },
    "command": "gnome-clocks",
    "finish-args": [
        "--device=dri",
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--socket=pulseaudio",
        "--share=network",
        "--metadata=X-DConf=migrate-path=/org/gnome/clocks/"
    ],
    "cleanup": [
        "/include",
        "/lib/girepository-1.0",
        "/lib/pkgconfig",
        "/share/pkgconfig",
        "/share/gir-1.0",
        "/share/vala"
    ],
    "modules": [
        {
            "name": "geocode-glib",
            "buildsystem": "meson",
            "config-opts": [
                "-Denable-installed-tests=false",
                "-Denable-introspection=true",
                "-Denable-gtk-doc=false",
                "-Dsoup2=false"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/geocode-glib/3.26/geocode-glib-3.26.4.tar.xz",
                    "sha256": "2d9a6826d158470449a173871221596da0f83ebdcff98b90c7049089056a37aa",
                    "x-checker-data": {
                        "type": "gnome",
                        "name": "geocode-glib"
                    }
                }
            ]
        },
        {
            "name": "libgweather",
            "buildsystem": "meson",
            "config-opts": [
                "-Dtests=false",
                "-Dgtk_doc=false"
            ],
            "modules": [
                {
                    "name": "gweather-locations",
                    "buildsystem": "meson",
                    "sources": [
                        {
                            "type": "archive",
                            "url": "https://download.gnome.org/sources/gweather-locations/2026/gweather-locations-2026.2.tar.xz",
                            "sha256": "e7570a3661e0a752a06387b2032585cf588fc56770b1f9f39f1a55d17b2835fe",
                            "x-checker-data": {
                                "type": "gnome",
                                "name": "gweather-locations"
                            }
                        }
                    ]
                }
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/libgweather/4.6/libgweather-4.6.0.tar.xz",
                    "sha256": "7f5d0e8c9685ef2ff46c2f3a57cae48d7bf3540b2d83921f889ef28e6a876788",
                    "x-checker-data": {
                        "type": "gnome",
                        "name": "libgweather",
                        "version-scheme": "odd-minor-is-unstable",
                        "versions": {
                            "<": "40.0",
                            ">=": "4.0.0"
                        }
                    }
                }
            ]
        },
        {
            "name": "gnome-desktop",
            "buildsystem": "meson",
            "config-opts": [
                "-Ddebug_tools=false",
                "-Dudev=disabled",
                "-Dgtk_doc=false",
                "-Ddesktop_docs=false",
                "-Dlegacy_library=false",
                "-Dbuild_gtk4=true"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/gnome-desktop/51/gnome-desktop-51.0.tar.xz",
                    "sha256": "9ebeb9f1769d3c310caeadd921ab34c8f264b92937740518b3bc859a579a6912",
                    "x-checker-data": {
                        "type": "gnome",
                        "name": "gnome-desktop"
                    }
                }
            ]
        },
        {
            "name": "vorbis-tools",
            "buildsystem": "autotools",
            "sources": [
                {
                    "type": "archive",
                    "url": "http://downloads.xiph.org/releases/vorbis/vorbis-tools-1.4.3.tar.gz",
                    "sha256": "a1fe3ddc6777bdcebf6b797e7edfe0437954b24756ffcc8c6b816b63e0460dde"
                }
            ]
        },
        {
            "name": "gnome-clocks",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.gnome.org/sources/gnome-clocks/51/gnome-clocks-51.0.tar.xz",
                    "sha256": "4bdf9c0481a83037da1d0fa26d2c2c6a80cb736458fd18fde14acaf7924874c6",
                    "x-checker-data": {
                        "type": "gnome",
                        "is-important": true,
                        "name": "gnome-clocks"
                    }
                }
            ]
        }
    ]
}
